# Copy to data/.env to keep credentials out of data/settings.json.
# A value here overrides the same setting in data/settings.json, and the
# web UI shows the field as locked. ${NAME} in a monitor's push_url,
# monitor_url or header values is replaced with NAME from this file.
UPTIME_API_KEY=
UPTIME_SECRET_KEY=
UPTIME_REMOTE_URL=
